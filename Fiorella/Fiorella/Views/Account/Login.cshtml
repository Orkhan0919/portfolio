@model Fiorella.ViewModels.Identity.LoginVM

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" rel="stylesheet">

<section class="vh-100 gradient-custom" style="background-color: #eee;">
    <div class="container py-5 h-100">
        <div class="row justify-content-center align-items-center h-100">
            <div class="col-12 col-md-8 col-lg-6 col-xl-5">
                <div class="card shadow-lg" style="border-radius: 15px;">
                    <div class="card-body p-4 p-md-5">
                        <h3 class="mb-4 text-center">Login</h3>
                        
                        <form asp-controller="Account" asp-action="Login" method="post">
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert" style="display:none;" ></div>
                             @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
                             {
                                 <div class="alert alert-danger">
                                     @foreach (var error in ViewData.ModelState[string.Empty].Errors)
                                     {
                                         <span>@error.ErrorMessage</span><br />
                                     }
                                 </div>
                             }

                            <div class="form-outline mb-4">
                                <label class="form-label" asp-for="Email">Email or Username</label>
                                <input asp-for="Email" class="form-control form-control-lg" placeholder="Enter your email" />
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>

                            <div class="form-outline mb-4">
                                <label class="form-label" asp-for="Password">Password</label>
                                <input asp-for="Password" type="password" class="form-control form-control-lg" placeholder="Enter password" />
                                <span asp-validation-for="Password" class="text-danger"></span>
                            </div>

                            <div class="text-center pt-1 mb-4 pb-1">
                                <button class="btn btn-primary btn-lg btn-block w-100" type="submit">Log in</button>
                            </div>

                            <div class="d-flex align-items-center justify-content-center pb-4">
                                <p class="mb-0 me-2">Don't have an account?</p>
                                <a asp-controller="Account" asp-action="Register" class="btn btn-outline-danger">Create new</a>
                            </div>

                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>