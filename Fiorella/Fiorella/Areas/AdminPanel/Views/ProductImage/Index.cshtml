@model IEnumerable<Fiorella.Models.ProductImage>
<div class="row">
    <div class="col-lg-12 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <h4 class="card-title">Product Images</h4>
                <div class="table-responsive">
                    <a asp-area="AdminPanel" asp-controller="ProductImage" asp-action="Create" class="btn btn-success mb-3">Create</a>
                    <table class="table table-striped">
                        <thead>
                        <tr>
                            <th>No#</th>
                            <th>Product</th>
                            <th>Image</th>
                            <th>Primary</th>
                            <th>Settings</th>
                        </tr>
                        </thead>
                        <tbody>
                        @{
                            var j = 0;
                        }
                        @foreach(var item in Model) {
                            j++;
                            <tr>
                                <td>@j</td>
                                <td>@item.Product?.Name</td>
                                <td><img src="~/assets/images/website-images/@item.ImageURL" style="width:60px;height:60px;object-fit:cover" /></td>
                                <td>@(item.IsPrimary == true ? "Yes" : "No")</td>
                                <td>
                                    <a asp-area="AdminPanel" asp-controller="ProductImage" asp-action="Details" asp-route-id="@item.Id" class="btn btn-primary">Details</a>
                                    <a asp-area="AdminPanel" asp-controller="ProductImage" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning">Edit</a>
                                    <a asp-area="AdminPanel" asp-controller="ProductImage" asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger">Delete</a>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>