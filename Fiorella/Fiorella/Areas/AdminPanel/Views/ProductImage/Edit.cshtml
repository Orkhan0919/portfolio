@model Fiorella.Models.ProductImage
<div class="row">
    <div class="col-md-6 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <h4 class="card-title">Edit Product Image</h4>
                <form asp-area="AdminPanel" asp-controller="ProductImage" asp-action="Edit" method="post" class="forms-sample">
                    <input type="hidden" asp-for="Id" />
                    <div class="form-group">
                        <label for="ProductId">Product</label>
                        <select asp-for="ProductId" class="form-control">
                            <option value="">Select Product</option>
                            @foreach(var p in ViewBag.Products as IEnumerable<Fiorella.Models.Product>) {
                                <option value="@p.Id" selected="@(Model.ProductId==p.Id ? "selected" : null)">@p.Name</option>
                            }
                        </select>
                        <span asp-validation-for="ProductId" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label for="ImageURL">Image URL</label>
                        <input asp-for="ImageURL" class="form-control" />
                        <span asp-validation-for="ImageURL" class="text-danger"></span>
                    </div>
                    <div class="form-group form-check">
                        <input asp-for="IsPrimary" class="form-check-input" />
                        <label class="form-check-label">Is Primary</label>
                    </div>
                    <button type="submit" class="btn btn-primary me-2">Save</button>
                    <a asp-area="AdminPanel" asp-controller="ProductImage" asp-action="Index" class="btn btn-light">Cancel</a>
                </form>
            </div>
        </div>
    </div>
</div>