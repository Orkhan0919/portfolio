@model Fiorella.Models.Product
<div class="row">
  <div class="col-md-8 grid-margin stretch-card">
    <div class="card">
      <div class="card-body">
        <h4 class="card-title">Edit Product</h4>
        <form asp-area="AdminPanel" asp-controller="Product" asp-action="Edit" method="post" class="forms-sample">
          <input type="hidden" asp-for="Id" />
          <div class="form-group">
            <label for="Name">Name</label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
          </div>
          <div class="form-group">
            <label for="CategoryId">Category</label>
            <select asp-for="CategoryId" class="form-control">
              <option value="">Select</option>
              @foreach(var c in ViewBag.Categories as IEnumerable<Fiorella.Models.Category>) {
                <option value="@c.Id" selected="@(Model.CategoryId==c.Id ? "selected" : null)">@c.Name</option>
              }
            </select>
            <span asp-validation-for="CategoryId" class="text-danger"></span>
          </div>
          <div class="form-row">
            <div class="form-group col-md-6">
              <label for="Price">Price</label>
              <input asp-for="Price" class="form-control" />
              <span asp-validation-for="Price" class="text-danger"></span>
            </div>
            <div class="form-group col-md-6">
              <label for="SKU">SKU</label>
              <input asp-for="SKU" class="form-control" />
              <span asp-validation-for="SKU" class="text-danger"></span>
            </div>
          </div>
          <div class="form-group">
            <label for="Description">Description</label>
            <textarea asp-for="Description" class="form-control" rows="4"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
          </div>
          <button type="submit" class="btn btn-primary me-2">Save</button>
          <a asp-area="AdminPanel" asp-controller="Product" asp-action="Index" class="btn btn-light">Cancel</a>
        </form>
      </div>
    </div>
  </div>
</div>
