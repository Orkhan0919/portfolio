@model List<WebApplication1.Models.Category>

<h2>Categories</h2>

<a class="btn btn-primary mb-3"
   href="@Url.Action("Create", "Category", new { area = "AdminPanel" })">
    Create New Category
</a>

<table class="table table-striped">
    <thead>
    <tr>
        <th>No_#</th>
        <th>Name</th>
        <th>Settings</th>
    </tr>
    </thead>
    <tbody>
    @for (int i = 0; i < Model.Count; i++)
    {
        <tr>
            <td>@(i + 1)</td>
            <td>@Model[i].Name</td>
            <td>
                <a class="btn btn-sm btn-info" href="#">Edit</a>
                <a class="btn btn-sm btn-danger" href="#">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>