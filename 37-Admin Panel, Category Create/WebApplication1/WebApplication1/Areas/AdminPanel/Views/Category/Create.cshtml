@model WebApplication1.Models.Category

<h2>Create Category</h2>

<form asp-action="Create" asp-controller="Category" asp-area="AdminPanel" method="post">
    <div class="mb-3">
        <label asp-for="Name" class="form-label">Category Name</label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-success">Save</button>
    <a class="btn btn-secondary" href="@Url.Action("Index", "Category", new { area = "AdminPanel" })">Back</a>
</form>