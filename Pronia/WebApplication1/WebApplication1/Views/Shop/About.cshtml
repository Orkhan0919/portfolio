@model WebApplication1.Models.HomeVM

@foreach (var product in Model.Products)
{
    <div class="col-xl-3 col-md-4 col-sm-6">
        <div class="product-item">
            <div class="product-img">
                <a href="@Url.Action("Detail", "Products", new { id = product.Id })">
                    <img class="primary-img"
                         src="~/pronia/assets/images/products/@product.PrimaryImg"
                         alt="@product.Name"/>
                    <img class="secondary-img"
                         src="~/pronia/assets/images/products/@product.SecondaryImg"
                         alt="@product.Name"/>
                </a>
                <div class="product-add-action">
                    <ul>
                        <li>
                            <a href="~/pronia/wishlist.html"
                               data-tippy="Add to wishlist"
                               data-tippy-inertia="true"
                               data-tippy-animation="shift-away"
                               data-tippy-delay="50" data-tippy-arrow="true"
                               data-tippy-theme="sharpborder">
                                <i class="pe-7s-like"></i>
                            </a>
                        </li>
                        <li class="quuickview-btn" data-bs-toggle="modal"
                            data-bs-target="#quickModal">
                            <a href="~/pronia/#" data-tippy="Quickview"
                               data-tippy-inertia="true"
                               data-tippy-animation="shift-away" data-tippy-delay="50"
                               data-tippy-arrow="true" data-tippy-theme="sharpborder">
                                <i class="pe-7s-look"></i>
                            </a>
                        </li>
                        <li>
                            <a href="~/pronia/cart.html" data-tippy="Add to cart"
                               data-tippy-inertia="true"
                               data-tippy-animation="shift-away"
                               data-tippy-delay="50" data-tippy-arrow="true"
                               data-tippy-theme="sharpborder">
                                <i class="pe-7s-cart"></i>
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
            <div class="product-content">
                <a class="product-name"
                   href="@Url.Action("Detail", "Products", new { id = product.Id })">@product.Name</a>
                <div class="price-box pb-1">
                    <span class="new-price">$@product.Price</span>
                </div>
                <div class="rating-box">
                    <ul>
                        <li><i class="fa fa-star"></i></li>
                        <li><i class="fa fa-star"></i></li>
                        <li><i class="fa fa-star"></i></li>
                        <li><i class="fa fa-star"></i></li>
                        <li><i class="fa fa-star"></i></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
}