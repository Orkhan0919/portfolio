@model WebApplication1.Models.ViewModels.LoginVM
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card border-0 shadow-lg p-4">
                <h2 class="text-center mb-4">Login</h2>
                
                <form asp-action="Login" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
                    
                    <div class="form-group mb-3">
                        <label asp-for="Email" class="form-label">Email Address</label>
                        <input asp-for="Email" class="form-control custom-input" placeholder="example@mail.com" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Password" class="form-label">Password</label>
                        <input asp-for="Password" type="password" class="form-control custom-input" placeholder="********" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="form-check mb-3">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label">Remember Me?</label>
                    </div>

                    <button type="submit" class="btn btn-green w-100 py-2">Sign In</button>
                </form>
                
                <div class="mt-3 text-center">
                    <small>Don't have an account? <a asp-action="Register" class="text-success">Register here</a></small>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .custom-input {
        border: 1px solid #ddd;
        transition: all 0.3s ease;
        box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.05); /* Giriş kölgəsi */
    }

    .custom-input:focus {
        border-color: #28a745;
        box-shadow: 0px 6px 12px rgba(40, 167, 69, 0.2); /* Fokusda yaşıl kölgə */
        outline: none;
    }

    .btn-green {
        background-color: #28a745; /* Yaşıl rəng */
        color: white;
        border: none;
        font-weight: bold;
        transition: 0.3s;
    }

    .btn-green:hover {
        background-color: #218838;
        transform: translateY(-2px);
        box-shadow: 0px 5px 10px rgba(0,0,0,0.1);
    }
</style>