@model WebApplication1.Models.ViewModels.RegisterVM
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-0 shadow-lg p-4">
                <h2 class="text-center mb-4">Create Account</h2>
                
                <form asp-action="Register" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Name" class="form-label">Name</label>
                            <input asp-for="Name" class="form-control custom-input" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Surname" class="form-label">Surname</label>
                            <input asp-for="Surname" class="form-control custom-input" />
                            <span asp-validation-for="Surname" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Username" class="form-label">Username</label>
                        <input asp-for="Username" class="form-control custom-input" />
                        <span asp-validation-for="Username" class="text-danger small"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Email" class="form-label">Email</label>
                        <input asp-for="Email" class="form-control custom-input" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Password" class="form-label">Password</label>
                        <input asp-for="Password" type="password" class="form-control custom-input" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>
                    <div class="form-group mb-3">
                        <label asp-for="ConfirmPassword" class="form-label">Confirm Password</label>
                        <input asp-for="ConfirmPassword" type="password" class="form-control custom-input" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-green w-100 py-2 mt-2">Sign Up</button>
                </form>

                <div class="mt-3 text-center">
                    <small>Already registered? <a asp-action="Login" class="text-success">Login here</a></small>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .custom-input {
        border: 1px solid #ddd;
        transition: all 0.3s ease;
        box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.05);
    }

    .custom-input:focus {
        border-color: #28a745;
        box-shadow: 0px 6px 12px rgba(40, 167, 69, 0.2);
        outline: none;
    }

    .btn-green {
        background-color: #28a745;
        color: white;
        border: none;
        font-weight: bold;
        transition: 0.3s;
    }

    .btn-green:hover {
        background-color: #218838;
        transform: translateY(-2px);
    }
</style>