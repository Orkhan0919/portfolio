@model List<WebApplication1.Models.Flowers>

<h2>Categories</h2>

<a class="btn btn-primary mb-3"
   href="@Url.Action("Create", "Slider", new { area = "AdminPanel" })">
    Create New Category
</a>

<table class="table table-striped">
    <thead>
    <tr>
        <th>No_#</th>
        <th>Name</th>
        <th>Settings</th>
    </tr>
    </thead>
    <tbody>
    @for (int i = 0; i < Model.Count; i++)
    {
        <tr>
            <td>@(i + 1)</td>
            <td>@Model[i].Title1</td>
            <td>
                <a class="btn btn-sm btn-info" 
                   asp-action="Edit" 
                   asp-route-id="@Model[i].Id">Edit</a>
        @if (User.IsInRole("SuperAdmin"))
                {
                    <a class="btn btn-sm btn-danger"
                       asp-action="Delete"
                       asp-route-id="@Model[i].Id"
                       onclick="return confirm('Are you sure you want to delete this?')">Delete</a>
                }
                <a class="btn btn-sm btn-warning" 
                   href="@Url.Action("Details", "Slider", new { area = "AdminPanel", id = Model[i].Id })">
                    Details
                </a>
            </td>
        </tr>
    }
    </tbody>
</table>