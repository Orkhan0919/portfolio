@model List<WebApplication1.Models.Product>

<h2>Products</h2> 

<a class="btn btn-primary mb-3"
   asp-action="Create" asp-controller="Product" asp-area="AdminPanel">
    Create New Product
</a>

<table class="table table-striped">
    <thead>
    <tr>
        <th>No_#</th>
        <th>Image</th> 
        <th>Name</th>
        <th>Price</th> 
        <th>Category</th> 
        <th>Settings</th>
    </tr>
    </thead>
    <tbody>
    @for (int i = 0; i < Model.Count; i++)
    {
        <tr>
            <td>@(i + 1)</td>
            <td>
                <img src="~/pronia/assets/images/products/@Model[i].PrimaryImg" width="50" alt="Product Image" />
            </td>
            <td>@Model[i].Name</td>
            <td>@Model[i].Price.ToString()</td> 
            <td>@Model[i].Category?.Name</td> 
            <td>
                <a class="btn btn-sm btn-info" 
                   asp-action="Edit" 
                   asp-route-id="@Model[i].Id">Edit</a>

                <a class="btn btn-sm btn-danger" 
                   asp-action="Delete" 
                   asp-route-id="@Model[i].Id" 
                   onclick="return confirm('Are you sure you want to delete this?')">Delete</a>

                <a class="btn btn-sm btn-warning" 
                   asp-action="Details" 
                   asp-route-id="@Model[i].Id">
                    Details
                </a>
            </td>
        </tr>
    }
    </tbody>
</table>