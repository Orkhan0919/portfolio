@model WebApplication1.ViewModels.ProductCreateVM
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<form asp-action="Create" method="post" enctype="multipart/form-data">
    <div class="mb-3">
        <label asp-for="MainPhoto">Main Photo</label>
        <input asp-for="MainPhoto" class="form-control" />
        <span asp-validation-for="MainPhoto" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="SecondaryPhoto">Secondary Photo</label>
        <input asp-for="SecondaryPhoto" class="form-control" />
        <span asp-validation-for="SecondaryPhoto" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Name">Name</label>
        <input asp-for="Name" class="form-control"/>
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="CategoryId">Category</label>
        <select asp-for="CategoryId" class="form-control" 
                asp-items="@(new SelectList(ViewBag.Categories, "Id", "Name"))">
            <option value="">-- Select Category --</option>
        </select>
        <span asp-validation-for="CategoryId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="TagIds">Select Tags</label>
        <select asp-for="TagIds" class="form-control" multiple>
            @foreach (var tag in ViewBag.Tags)
            {
                <option value="@tag.TagId">@tag.TagName</option>
            }
        </select>
        <small class="text-muted">Please keep CTRL while selecting tags if you want select more than one tag.</small>
    </div>
    <div class="mb-3">
        <label asp-for="Description">Description</label>
        <input asp-for="Description" class="form-control"/>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Price">Price</label>
        <input asp-for="Price" class="form-control" />
        <span asp-validation-for="Price" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="SKU">SKU</label>
        <input asp-for="SKU" class="form-control" />
        <span asp-validation-for="SKU" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-success">Save</button>
    <a asp-action="Index" class="btn btn-secondary">Back</a>
</form>