@model List<WebApplication1.Models.Tags>

<h2>Categories</h2>

<a class="btn btn-primary mb-3"
   href="@Url.Action("Create", "Tag", new { area = "AdminPanel" })">
    Create New Tag
</a>

<table class="table table-striped">
    <thead>
    <tr>
        <th>No_#</th>
        <th>Name</th>
        <th>Tag Id</th>
        <th>Settings</th>
    </tr>
    </thead>
    <tbody>
    @for (int i = 0; i < Model.Count; i++)
    {
        <tr>
            <td>@(i + 1)</td>
            <td>@Model[i].TagName</td>
            <td>@Model[i].TagId</td>
            <td>
                <a class="btn btn-sm btn-info" 
                   asp-action="Edit" 
                   asp-route-id="@Model[i].TagId">Edit</a>

                <a class="btn btn-sm btn-danger" 
                   asp-action="Delete" 
                   asp-route-id="@Model[i].TagId" 
                   onclick="return confirm('Are you sure you want to delete this?')">Delete</a>
                <a class="btn btn-sm btn-warning" 
                   href="@Url.Action("Details", "Tag", new { area = "AdminPanel", id = Model[i].TagId })">
                    Details
                </a>
            </td>
        </tr>
    }
    </tbody>
</table>